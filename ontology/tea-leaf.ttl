@prefix : <http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/> .

<http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection> rdf:type owl:Ontology ;
                                                                                 rdfs:comment "This is an ontology about tea diseses identification"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/environmentallySupported
:environmentallySupported rdf:type owl:ObjectProperty ;
                          rdfs:domain :LeafInstance ;
                          rdfs:range :Disease ;
                          rdfs:comment "inferred — reasoner concludes this" .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/favoredByCondition
:favoredByCondition rdf:type owl:ObjectProperty ;
                    rdfs:domain :Disease ;
                    rdfs:range :EnvironmentalCondition ;
                    rdfs:comment "this disease is favored by this condition" .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/favoredByMaturity
:favoredByMaturity rdf:type owl:ObjectProperty ;
                   rdfs:domain :Disease ;
                   rdfs:range :LeafMaturityStage ;
                   rdfs:comment "this disease favors this leaf stage" .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/favoredBySymptom
:favoredBySymptom rdf:type owl:ObjectProperty ;
                  rdfs:domain :Disease ;
                  rdfs:range :Symptom ;
                  rdfs:comment "this disease is associated with this symptom"@en .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :LeafInstance ;
              rdfs:range :EnvironmentalCondition ;
              rdfs:comment "current weather condition"@en .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/hasMaturity
:hasMaturity rdf:type owl:ObjectProperty ;
             rdfs:domain :LeafInstance ;
             rdfs:range :LeafMaturityStage ;
             rdfs:comment "leaf's growth stage"@en .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/hasSymptom
:hasSymptom rdf:type owl:ObjectProperty ;
            rdfs:comment "leaf instance exhibits this symptom"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/cnnConfidence
:cnnConfidence rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:float ;
               rdfs:comment "CNN's top-1 confidence score" .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/humidityValue
:humidityValue rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:float ;
               rdfs:comment "% humidity at capture time" .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/leafWetnessHours
:leafWetnessHours rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:float .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/rainfallValue
:rainfallValue rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:float ;
               rdfs:comment "rainfall measurement" .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/temperatureValue
:temperatureValue rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/AlgalLeafSpot
:AlgalLeafSpot rdf:type owl:Class ;
               rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BlackFruitingBodyDots
:BlackFruitingBodyDots rdf:type owl:Class ;
                       rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BlisterBlight
:BlisterBlight rdf:type owl:Class ;
               rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BrightSunshine
:BrightSunshine rdf:type owl:Class ;
                rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ConcentricRingPatch
:ConcentricRingPatch rdf:type owl:Class ;
                     rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Disease
:Disease rdf:type owl:Class .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Diseased
:Diseased rdf:type owl:Class ;
          rdfs:subClassOf :HealthLabel .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/EnvironmentalCondition
:EnvironmentalCondition rdf:type owl:Class .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/GreyBlight
:GreyBlight rdf:type owl:Class ;
            rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/GreySilveredCenter
:GreySilveredCenter rdf:type owl:Class ;
                    rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HealthLabel
:HealthLabel rdf:type owl:Class .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Healthy
:Healthy rdf:type owl:Class ;
         rdfs:subClassOf :HealthLabel .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighHumidity
:HighHumidity rdf:type owl:Class ;
              rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighTemperature
:HighTemperature rdf:type owl:Class ;
                 rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LeafInstance
:LeafInstance rdf:type owl:Class .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LeafMaturityStage
:LeafMaturityStage rdf:type owl:Class .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LeafWetnessLong
:LeafWetnessLong rdf:type owl:Class ;
                 rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LowTemperature
:LowTemperature rdf:type owl:Class ;
                rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/MatureLeaf
:MatureLeaf rdf:type owl:Class ;
            rdfs:subClassOf :LeafMaturityStage .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/PlantStress
:PlantStress rdf:type owl:Class ;
             rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/PoorAirCirculation
:PoorAirCirculation rdf:type owl:Class ;
                    rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust
:RedRust rdf:type owl:Class ;
         rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot
:ReddishHairySpot rdf:type owl:Class ;
                  rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RustySpot
:RustySpot rdf:type owl:Class ;
           rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/StemDieback
:StemDieback rdf:type owl:Class ;
             rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Symptom
:Symptom rdf:type owl:Class .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/TranslucentSpot
:TranslucentSpot rdf:type owl:Class ;
                 rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/WhitePowderyProtrusion
:WhitePowderyProtrusion rdf:type owl:Class ;
                        rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YellowPatchVariegation
:YellowPatchVariegation rdf:type owl:Class ;
                        rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YoungLeaf
:YoungLeaf rdf:type owl:Class ;
           rdfs:subClassOf :LeafMaturityStage .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection#test_leaf_001
:test_leaf_001 rdf:type owl:NamedIndividual ,
                        :LeafInstance ;
               :hasCondition :BrightSunshine_Instance ,
                             :HighTemperature_Instance ;
               :hasMaturity :YoungLeaf_Instance .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection#test_leaf_002
:test_leaf_002 rdf:type owl:NamedIndividual ,
                        :LeafInstance ;
               :hasCondition :HighHumidity_Instance ,
                             :LowTemperature_Instance ;
               :hasMaturity :YoungLeaf_Instance .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection#test_leaf_003
:test_leaf_003 rdf:type owl:NamedIndividual ,
                        :LeafInstance ;
               :hasCondition :HighHumidity_Instance ,
                             :PlantStress_Instance .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BlackFruitingBodyDots
:BlackFruitingBodyDots_Instance rdf:type owl:NamedIndividual ,
                                :BlackFruitingBodyDots .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BlisterBlight_Disease
:BlisterBlight_Disease rdf:type owl:NamedIndividual ,
                                :BlisterBlight ;
                       :favoredByCondition :HighHumidity_Instance ,
                                           :LeafWetnessLong_Instance ,
                                           :LowTemperature_Instance ;
                       :favoredByMaturity :YoungLeaf_Instance ;
                       :favoredBySymptom :TranslucentSpot_Instance ,
                                         :WhitePowderyProtrusion_Instance ;
                       rdfs:comment "Caused by fungus Exobasidium vexans. Young succulent leaves susceptible; mature leaves develop resistance to infection. Pale yellow or lime green translucent spots gradually enlarge. Protrusion on lower surface becomes white and powdery as spore production begins. Life cycle 3-4 weeks. Favoured by RH 80%+, temperature below 25C, leaf wetness 8-10 hours. Sunshine is detrimental to the fungus."@en .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BrightSunshine
:BrightSunshine_Instance rdf:type owl:NamedIndividual ,
                         :BrightSunshine .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ConcentricRingPatch
:ConcentricRingPatch_Instance rdf:type owl:NamedIndividual ,
                              :ConcentricRingPatch .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/GreyBlight_Disease
:GreyBlight_Disease rdf:type owl:NamedIndividual ,
                             :GreyBlight ;
                    :favoredByCondition :HighHumidity_Instance ,
                                        :HighTemperature_Instance ,
                                        :LeafWetnessLong_Instance ,
                                        :PlantStress_Instance ,
                                        :PoorAirCirculation_Instance ;
                    :favoredBySymptom :BlackFruitingBodyDots_Instance ,
                                      :ConcentricRingPatch_Instance ,
                                      :GreySilveredCenter_Instance ;
                    rdfs:comment "Dull brown spot expands into a circular to irregular patch, often with faint concentric zoning; centre fades to pale grey or silvered tone inside a darker brown border; minute black fruiting bodies appear as dots. Wound-dependent fungus — favoured by warm, humid conditions with poor air movement and long leaf wetness, but far more serious on debilitated bushes (drought stress, sunscorch, waterlogging, unbalanced nutrition, pest damage aftermath) than on vigorous ones. Attacks via wounds rather than tender leaf directly, unlike Blister Blight."@en .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/GreySilveredCenter
:GreySilveredCenter_Instance rdf:type owl:NamedIndividual ,
                             :GreySilveredCenter .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighHumidity
:HighHumidity_Instance rdf:type owl:NamedIndividual ,
                       :HighHumidity .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighTemperature
:HighTemperature_Instance rdf:type owl:NamedIndividual ,
                          :HighTemperature .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LeafWetnessLong
:LeafWetnessLong_Instance rdf:type owl:NamedIndividual ,
                          :LeafWetnessLong .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LowTemperature
:LowTemperature_Instance rdf:type owl:NamedIndividual ,
                         :LowTemperature .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/PlantStress
:PlantStress_Instance rdf:type owl:NamedIndividual ,
                      :PlantStress .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/PoorAirCirculation
:PoorAirCirculation_Instance rdf:type owl:NamedIndividual ,
                             :PoorAirCirculation .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Disease
:RedRust_Disease rdf:type owl:NamedIndividual ,
                          :RedRust ;
                 :favoredByCondition :BrightSunshine_Instance ,
                                     :HighHumidity_Instance ,
                                     :HighTemperature_Instance ;
                 :favoredByMaturity :YoungLeaf_Instance ;
                 :favoredBySymptom :ReddishHairySpot_Instance ,
                                   :RustySpot_Instance ,
                                   :StemDieback_Instance ,
                                   :YellowPatchVariegation_Instance ;
                 rdfs:comment "Caused by algae of genus Cephaleuros. Minute rusty spots on young unfolded tender leaves, roundish, enlarging to 10-15mm, reddish and hairy on upper leaf surface. Old and thick leaves become discolored. In later stage spots spread to stem; stem tissues killed in patches causing dieback, leaves of infected branches variegate with yellow patches. Favoured by bright sunshine, high temperature and humidity."@en .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot
:ReddishHairySpot_Instance rdf:type owl:NamedIndividual ,
                           :ReddishHairySpot .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RustySpot
:RustySpot_Instance rdf:type owl:NamedIndividual ,
                    :RustySpot .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/StemDieback
:StemDieback_Instance rdf:type owl:NamedIndividual ,
                      :StemDieback .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/TranslucentSpot
:TranslucentSpot_Instance rdf:type owl:NamedIndividual ,
                          :TranslucentSpot .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/WhitePowderyProtrusion
:WhitePowderyProtrusion_Instance rdf:type owl:NamedIndividual ,
                                 :WhitePowderyProtrusion .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YellowPatchVariegation
:YellowPatchVariegation_Instance rdf:type owl:NamedIndividual ,
                                 :YellowPatchVariegation .


###  http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YoungLeaf
:YoungLeaf_Instance rdf:type owl:NamedIndividual ,
                    :YoungLeaf .


#################################################################
#    Rules
#################################################################

:l rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:c1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:c2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:m rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "RedRustRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :LeafInstance ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :l
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasCondition ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :c1
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :BrightSunshine ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :c1
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasCondition ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :c2
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#classPredicate> :HighTemperature ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :c2
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasMaturity ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument2> :m
                                                                                                            ] ;
                                                                                                  rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                             rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#classPredicate> :YoungLeaf ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#argument1> :m
                                                                                                                       ] ;
                                                                                                             rdf:rest rdf:nil
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :environmentallySupported ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :RedRust_Disease
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "BlisterBlightRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :LeafInstance ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :l
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasCondition ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :c1
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :HighHumidity ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :c1
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasCondition ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :c2
                                                                                      ] ;
