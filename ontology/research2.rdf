    <!-- http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Disease -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Disease">
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Disease"/>
        <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BrightSunshine_Instance"/>
        <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighHumidity_Instance"/>
        <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighTemperature_Instance"/>
        <favoredByMaturity rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YoungLeaf_Instance"/>
        <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot_Instance"/>
        <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RustySpot_Instance"/>
        <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/StemDieback_Instance"/>
        <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YellowPatchVariegation_Instance"/>
        <hasTreatment rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_01"/>
        <hasTreatment rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_02"/>
        <hasTreatment rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_03"/>
        <rdfs:comment xml:lang="en">Caused by algae of genus Cephaleuros. Minute rusty spots on young unfolded tender leaves, roundish, enlarging to 10-15mm, reddish and hairy on upper leaf surface. Old and thick leaves become discolored. In later stage spots spread to stem; stem tissues killed in patches causing dieback, leaves of infected branches variegate with yellow patches. Favoured by bright sunshine, high temperature and humidity.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_01 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_01">
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Treatment"/>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <treatmentText>Strengthen the host plant, because red rust is more common on weak plants. Improve cultivation practices and apply fertiliser to minimise the damage.</treatmentText>
        <rdfs:comment>Source: Handbook on Tea, ch. 14 (Common Diseases of Tea and their Management), p.204</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_02 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_02">
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Treatment"/>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <treatmentText>Thatch young clearings during dry weather.</treatmentText>
        <rdfs:comment>Source: Handbook on Tea, ch. 14 (Common Diseases of Tea and their Management), p.204</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_03 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Treatment_03">
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/Treatment"/>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <treatmentText>Copper sprays are effective in keeping red rust under control: apply three rounds of spraying at 450 g of fungicide (50% copper) in 170 L of water per hectare.</treatmentText>
        <rdfs:comment>Source: Handbook on Tea, ch. 14 (Common Diseases of Tea and their Management), p.204</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot_Instance -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot_Instance">
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot"/>
    </owl:NamedIndividual>
    


