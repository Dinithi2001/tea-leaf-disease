  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BlisterBlight_Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BlisterBlight"/>
    <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighHumidity_Instance"/>
    <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LeafWetnessLong_Instance"/>
    <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/LowTemperature_Instance"/>
    <favoredByMaturity rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YoungLeaf_Instance"/>
    <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/TranslucentSpot_Instance"/>
    <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/WhitePowderyProtrusion_Instance"/>
    <rdfs:comment xml:lang="en">Caused by fungus Exobasidium vexans. Young succulent leaves susceptible; mature leaves develop resistance to infection. Pale yellow or lime green translucent spots gradually enlarge. Protrusion on lower surface becomes white and powdery as spore production begins. Life cycle 3-4 weeks. Favoured by RH 80%+, temperature below 25C, leaf wetness 8-10 hours. Sunshine is detrimental to the fungus.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na5883a5b4a6040218caa714a8d4bfaabb9">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns2:propertyPredicate rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/hasCondition"/>
    <ns2:argument1 rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/l"/>
    <ns2:argument2 rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/c2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust_Disease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RedRust"/>
    <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/BrightSunshine_Instance"/>
    <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighHumidity_Instance"/>
    <favoredByCondition rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/HighTemperature_Instance"/>
    <favoredByMaturity rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YoungLeaf_Instance"/>
    <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/ReddishHairySpot_Instance"/>
    <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/RustySpot_Instance"/>
    <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/StemDieback_Instance"/>
    <favoredBySymptom rdf:resource="http://www.semanticweb.org/user/ontologies/2026/7/tea-leaf-diseases-detection/YellowPatchVariegation_Instance"/>
    <rdfs:comment xml:lang="en">Caused by algae of genus Cephaleuros. Minute rusty spots on young unfolded tender leaves, roundish, enlarging to 10-15mm, reddish and hairy on upper leaf surface. Old and thick leaves become discolored. In later stage spots spread to stem; stem tissues killed in patches causing dieback, leaves of infected branches variegate with yellow patches. Favoured by bright sunshine, high temperature and humidity.</rdfs:comment>
  </rdf:Description>
